{
  "_comment": "How each attribute family reports usage. 'input_includes_cache': the input count already contains cache reads and writes (OpenTelemetry GenAI convention, OpenAI, OpenInference); Langfuse usage_details keys are exclusive buckets. Unknown usage-looking attributes are reported, not guessed.",
  "semconv_version": "GenAI semantic conventions as of 2026 (gen_ai.usage.*, gen_ai.operation.name, gen_ai.input/output.messages)",
  "gen_ai": {
    "input": "gen_ai.usage.input_tokens",
    "output": "gen_ai.usage.output_tokens",
    "cache_read": ["gen_ai.usage.cache_read.input_tokens"],
    "cache_write": ["gen_ai.usage.cache_creation.input_tokens"],
    "input_includes_cache": true,
    "nonstandard_aliases": {"gen_ai.usage.cache_write.input_tokens": "cache_write", "gen_ai.usage.cache_read_input_tokens": "cache_read", "gen_ai.usage.cache_creation_input_tokens": "cache_write", "gen_ai.usage.prompt_tokens": "input", "gen_ai.usage.completion_tokens": "output"},
    "ignored_prefixes": ["gen_ai.usage.details.", "gen_ai.usage.total_tokens", "gen_ai.aggregated_usage."]
  },
  "openinference": {
    "input": "llm.token_count.prompt",
    "output": "llm.token_count.completion",
    "cache_read": ["llm.token_count.prompt_details.cache_read"],
    "cache_write": ["llm.token_count.prompt_details.cache_write"],
    "input_includes_cache": true
  },
  "langfuse_usage_details": {
    "attribute": "langfuse.observation.usage_details",
    "cache_read_keys": ["input_cache_read", "cache_read_input_tokens", "input_cached_tokens", "cached_tokens"],
    "cache_write_keys": ["input_cache_creation", "cache_creation_input_tokens", "input_cache_write"],
    "ignore_keys": ["total", "total_tokens"]
  },
  "semconv_gen_ai_usage_names": ["gen_ai.usage.input_tokens", "gen_ai.usage.output_tokens", "gen_ai.usage.cache_read.input_tokens", "gen_ai.usage.cache_creation.input_tokens", "gen_ai.usage.reasoning.output_tokens"]
}
